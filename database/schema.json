{
  "project": "MealSync",
  "schema_version": "2.0",
  "owner": "person_1",
  "label": "PERSON 1 - Shared account, roles and organizations",
  "responsibility": "Own identity, global role definitions, organization records and organization memberships. The four role rows are seeded here.",
  "tables": {
    "users": {
      "description": "One login/account per person. A person can have more than one role.",
      "attributes": [
        {
          "name": "user_id",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "mealsync_id",
          "type": "VARCHAR(50)",
          "nullable": false
        },
        {
          "name": "name",
          "type": "VARCHAR(120)",
          "nullable": false
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "nullable": false
        },
        {
          "name": "phone",
          "type": "VARCHAR(30)",
          "nullable": true
        },
        {
          "name": "password_hash",
          "type": "VARCHAR(255)",
          "nullable": false
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      ],
      "primary key": [
        "user_id"
      ],
      "foreign_keys": [],
      "constraints": [
        {
          "type": "UNIQUE",
          "columns": [
            "mealsync_id"
          ]
        },
        {
          "type": "UNIQUE",
          "columns": [
            "email"
          ]
        }
      ]
    },
    "roles": {
      "description": "Available account roles. COMMUNITY_KITCHEN is a role, but each kitchen is also a separate entity.",
      "attributes": [
        {
          "name": "role_id",
          "type": "SMALLINT",
          "nullable": false
        },
        {
          "name": "role_name",
          "type": "VARCHAR(40)",
          "nullable": false
        },
        {
          "name": "description",
          "type": "VARCHAR(255)",
          "nullable": true
        }
      ],
      "primary key": [
        "role_id"
      ],
      "foreign_keys": [],
      "constraints": [
        {
          "type": "UNIQUE",
          "columns": [
            "role_name"
          ]
        }
      ],
      "seed_rows": [
        {
          "role_id": 1,
          "role_name": "VOLUNTEER"
        },
        {
          "role_id": 2,
          "role_name": "DONOR"
        },
        {
          "role_id": 3,
          "role_name": "ORGANIZATION"
        },
        {
          "role_id": 4,
          "role_name": "COMMUNITY_KITCHEN"
        }
      ]
    },
    "user_roles": {
      "description": "Many-to-many link between users and roles. A user may hold any combination of the four roles.",
      "attributes": [
        {
          "name": "user_id",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "role_id",
          "type": "SMALLINT",
          "nullable": false
        },
        {
          "name": "assigned_at",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      ],
      "primary key": [
        "user_id",
        "role_id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "user_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "user_id"
            ]
          },
          "on_delete": "CASCADE"
        },
        {
          "columns": [
            "role_id"
          ],
          "references": {
            "table": "roles",
            "columns": [
              "role_id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ],
      "constraints": []
    },
    "organizations": {
      "description": "An NGO or organizing body. It may have multiple member users and can create multiple events.",
      "attributes": [
        {
          "name": "organization_id",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "name",
          "type": "VARCHAR(160)",
          "nullable": false
        },
        {
          "name": "description",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "organization_type",
          "type": "VARCHAR(50)",
          "nullable": true
        },
        {
          "name": "address",
          "type": "TEXT",
          "nullable": true
        },
        {
          "name": "latitude",
          "type": "DECIMAL(9,6)",
          "nullable": true
        },
        {
          "name": "longitude",
          "type": "DECIMAL(9,6)",
          "nullable": true
        },
        {
          "name": "phone",
          "type": "VARCHAR(30)",
          "nullable": true
        },
        {
          "name": "email",
          "type": "VARCHAR(255)",
          "nullable": true
        },
        {
          "name": "website",
          "type": "VARCHAR(255)",
          "nullable": true
        },
        {
          "name": "created_at",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      ],
      "primary key": [
        "organization_id"
      ],
      "foreign_keys": [],
      "constraints": []
    },
    "organization_members": {
      "description": "Links users to organizations they can manage. The same user may be in more than one organization.",
      "attributes": [
        {
          "name": "organization_id",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "user_id",
          "type": "BIGINT",
          "nullable": false
        },
        {
          "name": "organization_role",
          "type": "VARCHAR(40)",
          "nullable": false,
          "default": "member"
        },
        {
          "name": "status",
          "type": "VARCHAR(20)",
          "nullable": false,
          "default": "active"
        },
        {
          "name": "joined_at",
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      ],
      "primary key": [
        "organization_id",
        "user_id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "organization_id"
          ],
          "references": {
            "table": "organizations",
            "columns": [
              "organization_id"
            ]
          },
          "on_delete": "CASCADE"
        },
        {
          "columns": [
            "user_id"
          ],
          "references": {
            "table": "users",
            "columns": [
              "user_id"
            ]
          },
          "on_delete": "CASCADE"
        }
      ],
      "constraints": [
        {
          "type": "CHECK",
          "expression": "status IN ('pending', 'active', 'inactive')"
        }
      ]
    }
  }
}
